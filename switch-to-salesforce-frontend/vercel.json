{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "framework": null,
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "switch-to-salesforce.vercel.app" }],
      "destination": "https://learn.switchtosalesforce.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:group/:topic/:article",
      "destination": "/post.html?group=:group&topic=:topic&slug=:article"
    },
    {
      "source": "/:group/:topic",
      "destination": "/topic.html?group=:group&topic=:topic"
    }
  ]
}
